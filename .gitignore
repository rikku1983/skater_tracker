# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Database (large binary — distribute separately)
data/*.db

# Supabase sync state (local only)
.supabase_sync_log.json

# Parse output (intermediate files, not for git)
data/parse_output/

# CSV files in data/pdfs (source data, not for git)
data/pdfs/**/*.csv

# Local Claude settings (session state, not project config)
.claude/settings.local.json

# Source image assets (copies in frontend/public/ are what matter)
pictures/

# PDFs (large — not tracked in git)
data/pdfs/
data/raw_pdfs/

# Scrape cache
data/scrape_cache/

# Windows metadata
*:Zone.Identifier
*.Zone.Identifier

# Next.js
frontend/.next/
frontend/node_modules/
frontend/.env*.local
frontend/tsconfig.tsbuildinfo

# Archive folder (ready to delete, not for git)
_archive/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
